{
    "ssh_connections": [
        {
            "host": "kibahome",
            "args": [],
            "projects": [
                {
                    "paths": [
                        "/home/krishan/Projects/homeserver"
                    ]
                },
                {
                    "paths": [
                        "/home/krishan/Projects/white-owl-trends"
                    ]
                }
            ]
        }
    ],
    "markdown_preview_font_size": 14.0,
    "focus_follows_mouse": {
        "enabled": false
    },
    "bottom_dock_layout": "contained",
    "tabs": {
        "git_status": true,
        "file_icons": true
    },
    "status_bar": {
        "show_active_file": false,
        "active_language_button": true
    },
    "tasks": {
        "enabled": true
    },
    "format_on_save": "off",
    "disable_ai": false,
    "cli_default_open_behavior": "new_window",
    "agent_servers": {

    },
    "agent": {
        "expand_edit_card": false,
        "play_sound_when_agent_done": "always",
        "notify_when_agent_waiting": "all_screens",
        "enable_feedback": false,
        "button": true,
        "favorite_models": [],
        "model_parameters": [],
    },
    "icon_theme": "VSCode Icons for Zed (Dark)",
    "git_panel": {
        "dock": "right",
    },
    "project_panel": {
        "sort_mode": "directories_first",
        "hide_root": true,
        "bold_folder_labels": false,
        "indent_size": 10.0,
        "dock": "left",
    },
    "agent_buffer_font_size": 10.0,
    "ui_font_size": 14.0,
    "agent_ui_font_size": 12.0,
    "buffer_line_height": "standard",
    "theme": {
        "mode": "dark",
        "dark": "One Dark Pro",
        "light": "One Light",
    },
    "buffer_font_family": ".ZedMono",
    "buffer_font_size": 12.0,
    "buffer_font_features": {
        "calt": false,
    },
    "tab_size": 4,
    "hard_tabs": false,
    "autosave": {
        "after_delay": {
            "milliseconds": 1000,
        },
    },
    "remove_trailing_whitespace_on_save": true,
    "ensure_final_newline_on_save": true,
    "show_whitespaces": "selection",
    "cursor_blink": true,
    "show_completions_on_input": true,
    "title_bar": {
        "show_project_items": true,
        "show_branch_name": true,
        "show_sign_in": false,
        "show_menus": false,
        "show_branch_status_icon": true,
    },
    "tab_bar": {
        "show_pinned_tabs_in_separate_row": true,
        "show_tab_bar_buttons": true,
        "show_nav_history_buttons": true,
    },
    "toolbar": {
        "breadcrumbs": false,
        "quick_actions": false,
    },
    "inlay_hints": {
        "enabled": true,
    },
    "terminal": {
        "scrollbar": {
            "show": "system"
        },
        "toolbar": {
            "breadcrumbs": false
        },
        "shell": {
            "with_arguments": {
                "program": "/bin/sh",
                "args": [
                    "-lc",
                    "exec env -i HOME=\"$HOME\" \"${SHELL:-/bin/bash}\" -l"
                ]
            }
        },
        "cursor_shape": "bar",
        "detect_venv": "off"
    },
    "languages": {
        "JavaScript": { "tab_size": 2 },
        "TypeScript": { "tab_size": 2 },
        "TSX": { "tab_size": 2 },
        "Python": { "tab_size": 4 },
        "YAML": { "tab_size": 2 },
        "JSON": { "tab_size": 2 },
    },
    "file_scan_exclusions": [
        "**/.git",
        "**/.hg",
        "**/.svn",
        "**/CVS",
        "**/.DS_Store",
        "**/__pycache__",
        "**/.mypy_cache",
        "**/.idea",
        "**/.data",
    ],
    "auto_install_extensions": {
        "graphql": true,
        "terraform": true,
        "dockerfile": true,
        "solidity": true,
        "mdx": true,
    },
}
